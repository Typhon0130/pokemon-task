{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["jest"],
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "isolatedModules": true
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "setup-jest.ts", "jest.config.ts"]
}
